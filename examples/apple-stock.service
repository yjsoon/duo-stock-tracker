# systemd user unit for the self-hosted checker.
# 1. Set WorkingDirectory to the absolute path of this checkout, and ExecStart to your `node` path (`command -v node`).
# 2. cp examples/apple-stock.service ~/.config/systemd/user/apple-stock.service
# 3. systemctl --user daemon-reload && systemctl --user enable --now apple-stock
# 4. loginctl enable-linger "$USER"   # keep it running after you log out
# Logs: journalctl --user -u apple-stock -f
[Unit]
Description=duo-stock-tracker pickup checker
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=%h/duo-stock-tracker
ExecStart=/usr/bin/node --env-file=.env src/node.js
Restart=always
RestartSec=60

[Install]
WantedBy=default.target
