# Self-hosted settings. Copy to .env (never commit .env). The Cloudflare Worker reads the same names from
# wrangler.jsonc "vars" and from `wrangler secret put`.

# Apple Store country: sg, us or ca (verified live), or another country code from apple.com/<cc>/shop (unverified).
COUNTRY=sg
# Postal code to search from: 238857 (SG), 10001 (US ZIP), M5V3L9 (CA).
POSTAL_CODE=238857
# 1 to 10 comma-separated part numbers for that country. List them with `npm run models`.
MODELS=MK2F4X/A,MK2G4X/A
# Skip stores farther than this many km, in every country (US distances are converted). 50 covers all of Singapore.
MAX_DISTANCE_KM=50
# Seconds between checks, +-20% jitter. Minimum 60. Shorter gaps make Apple return HTTP 541 more often.
INTERVAL_SECONDS=120
# The same store and model alerts at most once per this many minutes.
ALERT_COOLDOWN_MIN=60
# Send one "cannot read Apple" notice after this many minutes of failed checks. 0 turns it off.
STALE_ALERT_MIN=60

NTFY_SERVER=https://ntfy.sh
# Required. 16-64 letters, digits, - or _. Anyone who knows it can read your alerts: generate it with
#   node -e "console.log('apple-stock-' + crypto.randomUUID())"
NTFY_TOPIC=
# Only for a ntfy server that needs an access token.
NTFY_TOKEN=

# Product page linked from alerts and read by `npm run models`. Defaults to iPhone Duo in COUNTRY's store.
PRODUCT_URL=
